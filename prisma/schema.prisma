generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String   @id @default(cuid())
  name        String
  role        String
  status      String   @default("idle")
  organizationId String @default("default")
  organization String @default("default")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending")
  assigneeId  String?
  agent       Agent?   @relation(fields: [assigneeId], references: [id])
  organizationId String @default("default")
  organization String @default("default")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
